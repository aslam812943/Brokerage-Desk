generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  role               Role     @default(VIEWER)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model MasterClient {
  code      String   @id
  name      String   @default("")
  rm        String   @default("")
  dealer    String   @default("")
  branch    String   @default("")
  updatedAt DateTime @updatedAt
  // Generated column (see migration SQL) mirroring the normCode() convention
  // used client-side in Dashboard.jsx — lets SQL join DailyRecord <-> MasterClient
  // by code without depending on upload-to-upload casing/whitespace drift.
  codeNorm  String?  @unique
}

model Dealer {
  name      String   @id
  createdAt DateTime @default(now())
}

model Rm {
  name      String   @id
  createdAt DateTime @default(now())
}

model DailyRecord {
  id       String  @id @default(cuid())
  date     String
  code     String
  name     String  @default("")
  netBrok  Float   @default(0)
  source   String  @default("")
  // Generated column (see migration SQL) — see MasterClient.codeNorm.
  codeNorm String?

  @@index([date])
  @@index([code])
  // Every per-date lookup (Upload preview, Missing Finder diff, the
  // duplicate-source guard) filters by date AND source together.
  @@index([date, source])
  @@index([codeNorm])
}

model DebitRecord {
  id    String @id @default(cuid())
  date  String
  code  String
  name  String @default("")
  debit Float  @default(0)

  @@index([date])
  @@index([code])
  // Backs "latest debit per client" (DISTINCT ON (code) ... ORDER BY code, date DESC).
  @@index([code, date])
}

model Targets {
  id                  Int    @id @default(1)
  monthly             Float  @default(0)
  dealerMonthly       Json   @default("{}")
  kotakSharePct       Float  @default(85)
  rmSplitPct          Float  @default(50)
  // Per-dealer monthly salary, and the single company-wide "made X times
  // salary" multiplier that decides incentive eligibility on the Reports
  // tab's monthly view.
  dealerSalary        Json   @default("{}")
  incentiveMultiplier Float  @default(10)
}

model DealerTask {
  id     String  @id @default(cuid())
  dealer String
  month  String
  slot   Int
  text   String  @default("")
  done   Boolean @default(false)

  @@unique([dealer, month, slot])
  @@index([dealer, month])
}

// Admin-editable NSE/BSE trading holiday calendar — used to compute each
// dealer's Daily Target (monthly target / trading days in the month) on the
// MIS tab. Ships empty; dates aren't seeded since lunar-calendar holidays
// (Holi, Diwali, Eid, ...) shift every year and a wrong guess would silently
// corrupt the daily-target math.
model TradingHoliday {
  date String @id // ISO yyyy-mm-dd
  name String @default("")
}

// Immutable audit trail for all destructive / sensitive operations
model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String
  username  String
  action    String   // e.g. "DELETE_DAILY_RECORDS", "WIPE_MASTER_CLIENTS"
  detail    String   @default("") // JSON or human-readable context

  @@index([timestamp])
  @@index([userId])
}
